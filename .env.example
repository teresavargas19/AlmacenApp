# Copia este archivo a ".env" (ya está en .gitignore, así que nunca se sube
# al repo) y pon tus propios valores. El ".env" real que se genere junto con
# esto ya trae valores aleatorios listos para desarrollo local.

# Contraseña del usuario "sa" del SQL Server que corre dentro de Docker.
# Debe tener al menos 8 caracteres e incluir mayúsculas, minúsculas, números
# y símbolos.
MSSQL_SA_PASSWORD=CambiaEstaClave!2026

# Clave para firmar los tokens JWT del backend. Usa una cadena larga y
# aleatoria (no reutilices la que está en appsettings.json).
JWT_KEY=cambia-esta-clave-jwt-por-una-larga-y-aleatoria
